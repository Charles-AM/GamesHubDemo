generator client {
 provider = "prisma-client"
 output = "../generated/prisma"
}
datasource db {
 provider = "postgresql"
}
model User {
 id String @id @default(uuid())
 email String @unique
 username String
 passwordHash String?
 googleId String? @unique
 xp Int @default(0)
 streak Int @default(0)
 lastLogin String?
 createdAt DateTime @default(now())
 matches Match[]
}
model Match {
 id String @id @default(uuid())
 clientId String
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 game String
 score Int
 duration Int
 playedAt DateTime
 ranked Boolean @default(false)
 opponent String?
 createdAt DateTime @default(now())
 @@unique([userId,clientId])
 @@index([userId,playedAt(sort:Desc)])
 @@index([game,ranked,score(sort:Desc)])
}
