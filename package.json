{
  "name": "arcadia-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "build": "npm run build -w packages/shared && npm run build -w packages/engine && npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/api",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "concurrently": "10.0.5",
    "picomatch": "^4.0.7",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
